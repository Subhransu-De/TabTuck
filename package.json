{
  "name": "tabtuck",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:browser": "bun browser-check.mjs",
    "build": "bun run build:css && bun scripts/build.mjs && web-ext build --source-dir dist/TabTuck --artifacts-dir dist --filename TabTuck.zip --overwrite-dest",
    "build:css": "tailwindcss -i styles/manage.css -o manage.css --minify",
    "dev:css": "tailwindcss -i styles/manage.css -o manage.css --watch",
    "lint:js": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "bun run lint && bun run format:check && bun test && bun run build && bun run lint:extension",
    "lint:css": "stylelint \"styles/**/*.css\" --max-warnings 0",
    "format:check": "prettier --check .",
    "lint:extension": "bun scripts/lint-extension.mjs",
    "lint": "bun run lint:js && bun run lint:css",
    "test:restore": "bun restore-ui-check.mjs",
    "audit:dependencies": "bun audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "web-ext": "^10.6.0"
  }
}
