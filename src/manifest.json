{
  "manifest_version": 3,
  "name": "TabTuck: Save Tabs for Later",
  "short_name": "TabTuck",
  "version": "1.2.1",
  "description": "A private tab manager: save tabs for later, sort them into collections, search them, and restore them in the same window.",
  "permissions": ["tabs", "storage", "contextMenus", "favicon"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Show TabTuck",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "manager/manage.html#settings",
  "commands": {
    "save-current": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Save the current tab"
    },
    "show-manager": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Show TabTuck"
    }
  }
}
